# Variables de l'espace admin — à définir dans Vercel (Settings → Environment Variables)

# Personnes autorisées : « email:code », séparées par des points-virgules.
# Choisir des codes longs (12 caractères ou plus).
ADMIN_USERS="prenom.nom@exemple.fr:un-code-long-et-secret;autre@exemple.fr:autre-code-secret"

# Chaîne aléatoire d'au moins 32 caractères qui signe les sessions (ex. : openssl rand -hex 32)
ADMIN_SECRET=""

# Jeton GitHub « fine-grained » limité au dépôt du site, permission « Contents : Read and write ».
# Sans ce jeton, en local, les modifications sont écrites directement dans les fichiers du projet.
GITHUB_TOKEN=""
GITHUB_REPO="KingIrdawen/Morez-Handball-site-web"
GITHUB_BRANCH="main"
