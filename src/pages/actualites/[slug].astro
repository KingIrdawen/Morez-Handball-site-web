---
import { Image } from 'astro:assets'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import Icon from '@/components/Icon.astro'
import SectionTitle from '@/components/SectionTitle.astro'
import NewsCard from '@/components/NewsCard.astro'

export async function getStaticPaths() {
  const news = (await getCollection('actualites')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  return news.map(article => ({
    params: { slug: article.id },
    props: { article, related: news.filter(n => n.id !== article.id).slice(0, 3) },
  }))
}

const { article, related } = Astro.props as { article: CollectionEntry<'actualites'>; related: CollectionEntry<'actualites'>[] }
const { title, category, excerpt, image, imageAlt } = article.data
const { Content } = await render(article)
---
<Layout title={title} description={excerpt}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
    <a href="/actualites/" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.3em] text-gold">
      <Icon name="arrow-left" class="h-3.5 w-3.5" />Toutes les actualités
    </a>
    <p class="mt-8 text-xs font-semibold uppercase tracking-[0.35em] text-gold">{category}</p>
    <h1 class="mt-3 text-4xl uppercase leading-none sm:text-5xl">{title}</h1>
    <p class="mt-6 text-lg text-muted-foreground">{excerpt}</p>
    <div class="mt-8 flex justify-center border border-border bg-ink">
      <Image src={image} alt={imageAlt ?? title} widths={[640, 1000, 1400]} sizes="(min-width: 768px) 720px, 100vw" class="max-h-[80vh] w-auto object-contain" loading="eager" />
    </div>
    <div class="article-body mt-8 space-y-4 text-muted-foreground">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="border-t border-border">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
        <SectionTitle title="À lire aussi" />
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map(n => <NewsCard article={n} compact />)}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  /* Mise en forme du texte écrit en Markdown */
  .article-body :global(a) {
    color: var(--color-gold);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .article-body :global(h2) {
    margin-top: 2rem;
    font-size: 1.875rem;
    color: var(--color-foreground);
    text-transform: uppercase;
  }
  .article-body :global(strong) {
    color: var(--color-foreground);
  }
  .article-body :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .article-body :global(img) {
    border: 1px solid var(--color-border);
  }
</style>
