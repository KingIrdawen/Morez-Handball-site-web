---
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import SectionTitle from '@/components/SectionTitle.astro'
import Icon from '@/components/Icon.astro'
import heroImage from '@/assets/equipes/moins-de-11.jpg'
import { club, phoneHref } from '@/data/site'

// Les coordonnées viennent de src/data/site.ts
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${club.venue} ${club.venueAddress}`)}`
---
<Layout title="Contact" description={`Contactez Morez Handball : ${club.phone}, ${club.email}. Entraînements et matchs au ${club.venue}, ${club.venueAddress}.`}>
  <PageHero
    image={heroImage}
    eyebrow="Écrivez-nous"
    title="Contact"
    intro="Licence, créneaux ou partenariat : contactez le club ou retrouvez-nous au gymnase."
  />

  <section class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
    <div>
      <SectionTitle eyebrow="Le club" title="Nous contacter" />
      <ul class="space-y-6">
        <li class="flex items-start gap-4">
          <Icon name="map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-gold" />
          <div>
            <p class="font-bold uppercase">Adresse postale</p>
            <address class="text-muted-foreground not-italic">
              {club.fullName}<br />{club.address}<br />{club.postalCode}
            </address>
          </div>
        </li>
        {club.phone && (
          <li class="flex items-start gap-4">
            <Icon name="phone" class="mt-0.5 h-5 w-5 shrink-0 text-gold" />
            <div>
              <p class="font-bold uppercase">Téléphone</p>
              <a href={phoneHref(club.phone)} class="text-muted-foreground transition-colors hover:text-gold">{club.phone}</a>
            </div>
          </li>
        )}
        {club.email && (
          <li class="flex items-start gap-4">
            <Icon name="mail" class="mt-0.5 h-5 w-5 shrink-0 text-gold" />
            <div class="min-w-0">
              <p class="font-bold uppercase">E-mail</p>
              <a href={`mailto:${club.email}`} class="break-all text-muted-foreground transition-colors hover:text-gold">{club.email}</a>
            </div>
          </li>
        )}
      </ul>
    </div>

    <div>
      <SectionTitle eyebrow="Entraînements et matchs" title="Nous trouver" />
      <div class="flex items-start gap-4">
        <Icon name="map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-gold" />
        <div>
          <p class="font-bold uppercase">Salle</p>
          <address class="text-muted-foreground not-italic">{club.venue}<br />{club.venueAddress}</address>
          <a href={mapsUrl} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-gold">
            Voir sur la carte <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
