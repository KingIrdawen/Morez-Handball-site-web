---
import Layout from '@/layouts/Layout.astro'
import Icon from '@/components/Icon.astro'
---
<Layout title="Page introuvable">
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-4 py-24 text-center">
    <p class="font-display text-8xl text-gold">404</p>
    <h1 class="mt-4 text-4xl uppercase">Hors-jeu !</h1>
    <p class="mt-4 text-muted-foreground">Cette page n'existe pas ou a été déplacée.</p>
    <a href="/" class="mt-8 inline-flex items-center gap-2 bg-gold px-6 py-3 font-bold uppercase tracking-wide text-ink">Retour à l'accueil <Icon name="arrow-right" /></a>
  </section>
</Layout>
