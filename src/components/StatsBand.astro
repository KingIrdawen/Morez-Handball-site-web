---
import { stats } from '@/data/site'
---
<section class="border-y border-border bg-ink">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-4 py-12 sm:px-6 md:grid-cols-4">
    {stats.map(s => (
      <div>
        <p class="font-display text-4xl text-gold sm:text-5xl">{s.value}</p>
        <p class="mt-1 text-xs uppercase tracking-wide text-muted-foreground">{s.label}</p>
      </div>
    ))}
  </div>
</section>
