---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '@/assets/club/logo.png'
import { club, navigation } from '@/data/site'

// Lien actif : la rubrique dont l'adresse est le début de la page courante
const path = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
---
<header class="sticky top-0 z-40 border-b border-border bg-ink/90 backdrop-blur">
  <div class="mx-auto flex h-17 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt="Blason Morez Handball" height={96} class="h-12 w-auto" loading="eager" />
      <span class="leading-none">
        <span class="block font-display text-xl uppercase">{club.name}</span>
        <span class="mt-1 block text-[0.62rem] font-semibold uppercase tracking-[0.3em] text-gold">{club.tagline}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navigation principale">
      {navigation.map(item => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'text-sm font-semibold uppercase tracking-wide transition-colors hover:text-gold',
            isActive(item.href) ? 'text-gold' : 'text-foreground/80',
          ]}
        >{item.label}</a>
      ))}
      <a href="/rejoindre/" class="bg-gold px-4 py-2 text-sm font-bold uppercase tracking-wide text-ink transition-transform hover:-translate-y-0.5">Rejoindre</a>
    </nav>

    <button
      type="button"
      class="grid h-10 w-10 place-items-center border border-border lg:hidden"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span data-menu-icon="open"><Icon name="menu" class="h-5 w-5" /></span>
      <span data-menu-icon="close" class="hidden"><Icon name="x" class="h-5 w-5" /></span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-border bg-ink px-4 pb-5 lg:hidden" aria-label="Navigation mobile">
    {navigation.map(item => (
      <a
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
        class:list={[
          'block border-b border-border py-3.5 text-sm font-semibold uppercase tracking-wide',
          isActive(item.href) ? 'text-gold' : 'text-foreground/80',
        ]}
      >{item.label}</a>
    ))}
    <a href="/rejoindre/" class="mt-4 block bg-gold py-3 text-center text-sm font-bold uppercase tracking-wide text-ink">Rejoindre le club</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const menu = document.getElementById('mobile-menu')
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true'
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu')
    menu?.classList.toggle('hidden', !open)
    toggle.querySelector('[data-menu-icon="open"]')?.classList.toggle('hidden', open)
    toggle.querySelector('[data-menu-icon="close"]')?.classList.toggle('hidden', !open)
  })
</script>
