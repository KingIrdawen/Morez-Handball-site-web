---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import logo from '@/assets/club/logo.png'
import { club, footerLinks, phoneHref } from '@/data/site'

const year = new Date().getFullYear()
---
<footer class="border-t border-border bg-ink">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
    <div>
      <a href="/" class="flex items-center gap-3">
        <Image src={logo} alt="" height={112} class="h-14 w-auto" />
        <span class="leading-none">
          <span class="block font-display text-2xl uppercase">{club.name}</span>
          <span class="mt-1 block text-xs font-semibold uppercase tracking-[0.3em] text-gold">{club.tagline}</span>
        </span>
      </a>
      <p class="mt-5 max-w-sm text-sm text-muted-foreground">{club.description}</p>
    </div>

    <div>
      <p class="font-display text-xl uppercase text-gold">Navigation</p>
      <div class="mt-4 grid grid-cols-2 gap-x-6 text-sm text-muted-foreground">
        {footerLinks.map(column => (
          <ul class="space-y-3">
            {column.map(l => <li><a href={l.href} class="transition-colors hover:text-gold">{l.label}</a></li>)}
          </ul>
        ))}
      </div>
    </div>

    <div>
      <p class="font-display text-xl uppercase text-gold">Contact</p>
      <ul class="mt-4 space-y-3 text-sm text-muted-foreground">
        <li class="flex items-start gap-2.5"><Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-gold" /><span>{club.venue}<br />{club.venueAddress}</span></li>
        {club.phone && <li><a href={phoneHref(club.phone)} class="flex items-center gap-2.5 hover:text-gold"><Icon name="phone" class="h-4 w-4 shrink-0 text-gold" />{club.phone}</a></li>}
        {club.email && <li><a href={`mailto:${club.email}`} class="flex items-center gap-2.5 break-all hover:text-gold"><Icon name="mail" class="h-4 w-4 shrink-0 text-gold" />{club.email}</a></li>}
      </ul>
    </div>
  </div>
  <div class="border-t border-border py-5 text-center text-xs text-muted-foreground">
    © {year} {club.fullName}. Tous droits réservés.
  </div>
</footer>
