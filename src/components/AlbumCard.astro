---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import { albumCover, albumPhotos, type Album } from '@/data/albums'

// `wide` : grande bannière de l'accueil ; sinon carte de la page Galerie
interface Props {
  album: Album
  wide?: boolean
}
const { album, wide = false } = Astro.props
const count = albumPhotos(album).length
---
<a href={`/galerie/${album.slug}/`} class:list={['group relative block overflow-hidden border border-border', wide ? 'aspect-[4/3] sm:aspect-[12/5]' : 'aspect-[3/2]']}>
  <Image src={albumCover(album)} alt={album.title} widths={[640, 1200, 1800]} sizes={wide ? '(min-width: 1280px) 1232px, 100vw' : '(min-width: 1024px) 600px, 100vw'} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
  <span class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-transparent transition-opacity duration-300 group-hover:from-ink group-hover:via-ink/65"></span>
  <span class:list={['absolute inset-x-0 bottom-0', wide ? 'p-6 sm:p-10' : 'p-6']}>
    <span class="flex flex-wrap items-center gap-4 text-xs font-semibold uppercase tracking-[0.35em]">
      {wide && <span class="text-gold">{album.season}</span>}
      <span class:list={['inline-flex items-center gap-2 transition-colors group-hover:text-gold', wide ? 'text-muted-foreground' : 'text-gold']}><Icon name="images" class="h-4 w-4" /> {count} photos</span>
    </span>
    <span class:list={['mt-4 block font-display uppercase leading-none', wide ? 'text-4xl sm:text-5xl lg:text-6xl' : 'text-4xl']}>{album.title}</span>
    {wide
      ? <span class="gold-rule mt-5 block w-16 transition-all duration-300 group-hover:w-28"></span>
      : <span class="mt-3 block text-sm text-muted-foreground">{album.team} · {album.place}</span>}
    <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-gold">Voir l'album <Icon name="arrow-right" /></span>
  </span>
</a>
