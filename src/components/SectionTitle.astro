---
interface Props {
  eyebrow?: string
  title: string
  center?: boolean
  class?: string
}
const { eyebrow, title, center = false, class: className = 'mb-10' } = Astro.props
---
<div class:list={[className, center && 'text-center']}>
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.35em] text-gold">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl uppercase sm:text-4xl">{title}</h2>
  <div class:list={['gold-rule mt-4 w-20', center && 'mx-auto']}></div>
</div>
