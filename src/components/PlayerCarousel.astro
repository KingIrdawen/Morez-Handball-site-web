---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import type { Player } from '@/data/players'

interface Props {
  players: Player[]
  label: string
}
const { players, label } = Astro.props
const pad = (n: number) => String(n).padStart(2, '0')
---
<div class="relative" data-carousel role="region" aria-roledescription="carousel" aria-label={label}>
  <!-- Trait doré décoratif en diagonale derrière les cartes -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-1/2 w-px -translate-x-1/2 rotate-[18deg] bg-gradient-to-b from-transparent via-gold/40 to-transparent"></div>

  <div class="overflow-hidden" data-viewport>
    <div class="flex items-center py-5 transition-transform duration-500 ease-out motion-reduce:transition-none sm:py-8" data-track>
      {players.map((p, i) => (
        <div
          class="min-w-0 shrink-0 grow-0 basis-[88%] px-2 transition-[opacity,transform,filter] duration-500 ease-out motion-reduce:transition-none sm:basis-[64%] lg:basis-[46%] xl:basis-[40%]"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} sur ${players.length} : ${p.firstName} ${p.lastName}, ${p.position}`}
          data-slide
        >
          <button type="button" class="roster-card group relative block w-full cursor-pointer overflow-hidden border border-gold/25 bg-card text-left focus-visible:ring-2 focus-visible:ring-gold focus-visible:outline-none" aria-label={`${p.firstName} ${p.lastName}, ${p.position}`}>
            <span aria-hidden="true" class="absolute top-6 left-1/2 z-0 w-[140%] -translate-x-1/2 text-center font-display text-[clamp(4rem,11vw,9rem)] leading-none text-foreground/[0.045] uppercase">{p.lastName}</span>
            <Image
              src={p.photo}
              alt={`${p.firstName} ${p.lastName}, ${p.position} de Morez Handball`}
              widths={[480, 800, 1100]}
              sizes="(min-width: 1280px) 40vw, (min-width: 1024px) 46vw, (min-width: 640px) 64vw, 88vw"
              loading={i < 2 ? 'eager' : 'lazy'}
              class="relative z-[1] h-full w-full object-cover"
              style={`object-position: center ${p.focus ?? '18%'}`}
            />
            <span class="absolute inset-x-0 bottom-0 z-[2] bg-gradient-to-t from-background via-background/90 to-transparent px-5 pt-24 pb-6 sm:px-8 sm:pb-8">
              <span class="mb-3 inline-flex border border-gold/50 bg-background/80 px-3 py-1 text-[0.65rem] font-bold tracking-[0.25em] text-gold uppercase backdrop-blur-sm">{p.position}</span>
              <span class="block font-display text-4xl leading-[0.82] text-foreground uppercase sm:text-5xl lg:text-6xl">{p.firstName}<br /><span class="text-gold">{p.lastName}</span></span>
            </span>
            <span class="absolute top-5 right-5 z-[2] font-display text-xl text-gold/70">{pad(i + 1)}</span>
          </button>
        </div>
      ))}
    </div>
  </div>

  <div class="mx-auto mt-6 flex max-w-3xl items-center justify-between gap-4 px-4">
    <button type="button" class="grid h-11 w-11 place-items-center border border-gold/50 text-gold transition-colors hover:bg-gold hover:text-ink" aria-label="Joueur précédent" data-prev>
      <Icon name="arrow-left" />
    </button>
    <div class="flex items-center gap-2" data-dots>
      {players.map((p, i) => (
        <button type="button" class="h-1 w-2.5 bg-foreground/25 transition-all" aria-label={`Voir ${p.firstName} ${p.lastName}`} data-dot={i}></button>
      ))}
    </div>
    <button type="button" class="grid h-11 w-11 place-items-center border border-gold/50 text-gold transition-colors hover:bg-gold hover:text-ink" aria-label="Joueur suivant" data-next>
      <Icon name="arrow-right" />
    </button>
  </div>
  <p class="mt-4 text-center font-display text-xl" aria-live="polite">
    <span class="text-gold" data-current>01</span> <span class="text-muted-foreground">/</span> {pad(players.length)}
  </p>
</div>

<script>
  // Carrousel : la carte active est centrée, les voisines sont réduites et atténuées
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')!
    const track = root.querySelector<HTMLElement>('[data-track]')!
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')]
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')]
    const current = root.querySelector<HTMLElement>('[data-current]')!
    let index = 0

    function render() {
      const slide = slides[index]
      const offset = viewport.clientWidth / 2 - (slide.offsetLeft + slide.offsetWidth / 2)
      track.style.transform = `translate3d(${offset}px, 0, 0)`
      slides.forEach((s, i) => {
        const active = i === index
        s.style.transform = active ? 'scale(1)' : 'scale(0.88)'
        s.style.opacity = active ? '1' : '0.4'
        s.style.filter = active ? 'none' : 'grayscale(35%)'
        s.style.zIndex = active ? '10' : '0'
        s.querySelector('button')?.setAttribute('aria-current', String(active))
      })
      dots.forEach((d, i) => {
        d.classList.toggle('bg-gold', i === index)
        d.classList.toggle('w-8', i === index)
        d.classList.toggle('bg-foreground/25', i !== index)
        d.classList.toggle('w-2.5', i !== index)
      })
      current.textContent = String(index + 1).padStart(2, '0')
    }

    const go = (i: number) => { index = (i + slides.length) % slides.length; render() }
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1))
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1))
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)))
    slides.forEach((s, i) => s.querySelector('button')?.addEventListener('click', () => go(i)))
    root.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') go(index - 1)
      if (e.key === 'ArrowRight') go(index + 1)
    })

    // Glisser au doigt sur mobile
    let startX = 0
    viewport.addEventListener('touchstart', e => { startX = e.touches[0].clientX }, { passive: true })
    viewport.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - startX
      if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1))
    })

    window.addEventListener('resize', render)
    render()
  }
</script>
