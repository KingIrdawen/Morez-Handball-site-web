---
import { Image } from 'astro:assets'
import { clubs, type ClubKey } from '@/data/matches'

interface Props {
  club: ClubKey
  size?: 'sm' | 'lg'
}
const { club, size = 'sm' } = Astro.props
const { name, logo } = clubs[club]
---
<span class:list={['flex shrink-0 items-center justify-center rounded-full bg-ink/70 ring-1 ring-gold/20', size === 'lg' ? 'h-24 w-24 p-2' : 'h-12 w-12 p-1']}>
  <Image src={logo} alt={`Logo ${name}`} width={size === 'lg' ? 160 : 96} class="h-full w-full min-h-0 object-contain" />
</span>
